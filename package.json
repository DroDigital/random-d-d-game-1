{
  "name": "ashen-oath",
  "version": "1.0.0",
  "private": true,
  "description": "Ashen Oath - a local co-op D&D 5e souls-like roguelite (1-4 players) that runs in any browser, no engine required.",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "check": "node tools/smoke-test.mjs",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:all": "npm run build && electron-builder --linux --win --mac --publish never"
  },
  "devDependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "howler": "^2.2.4",
    "rot-js": "^2.2.1",
    "three": "^0.170.0"
  },
  "main": "desktop/main.js",
  "author": "Ashen Oath",
  "homepage": "https://github.com/DroDigital/random-d-d-game-1",
  "build": {
    "appId": "io.github.drodigital.ashenoath",
    "productName": "Ashen Oath",
    "copyright": "Ashen Oath. Assets CC0 / CC BY 3.0, see licenses.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "play/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "compression": "normal",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ashen Oath",
      "artifactName": "AshenOath-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AshenOath-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "AshenOath-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "AshenOath-${version}-mac.${ext}"
    }
  }
}
